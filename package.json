{
  "name": "world-o-rama",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A map quiz about who exploited whom throughout history. Dry humor included.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "electron": "vite build && electron .",
    "package:linux": "node scripts/package.mjs linux",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^18.19.130",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "main": "electron/main.cjs",
  "author": "Skatterbrainz",
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/Skatterbrainz/World-O-Rama",
  "build": {
    "appId": "com.skatterbrainz.worldorama",
    "productName": "World-O-Rama",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "world-o-rama",
      "artifactName": "World-O-Rama-${version}-${arch}.AppImage",
      "synopsis": "A map quiz about who exploited whom throughout history",
      "syncDesktopName": true
    }
  },
  "desktopName": "world-o-rama.desktop"
}
